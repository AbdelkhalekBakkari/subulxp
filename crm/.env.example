# Port HTTP
PORT=3000
# Chemin de la base SQLite (dossier monté en volume en production)
DATABASE_PATH=./data/crm.db
# Mode journal SQLite : WAL sur disque local (défaut), DELETE sur un partage réseau (Azure Files, NFS, SMB)
SQLITE_JOURNAL_MODE=WAL
# Mettre à "true" derrière un reverse proxy HTTPS (cookies Secure + trust proxy)
TRUST_PROXY=false
# Secret de signature des cookies de session (32+ caractères aléatoires)
SESSION_SECRET=change-me-please-use-a-long-random-string
# Durée de session en heures
SESSION_HOURS=12
# Origines autorisées à appeler /api/public/leads (formulaire landing), séparées par des virgules
INTAKE_ALLOWED_ORIGINS=https://xp.subul.uk
# Compte admin initial créé au premier démarrage si aucun utilisateur n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
